{
  "name": "print-scraping",
  "version": "0.1.0",
  "private": true,
  "description": "Captura, edição e leitura de screenshots localmente.",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -p tsconfig.electron.json && tsc --noEmit && vite build --config vite.config.ts",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tesseract.js": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
}
